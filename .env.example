# PDF NEXUS - Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Security & Tokens
SECRET_KEY=generate-a-strong-random-secret-key-for-production-use
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage
MAX_UPLOAD_SIZE_BYTES=52428800

# Database
DATABASE_URL=sqlite:///./pdf_nexus.db
# For PostgreSQL in production, use:
# DATABASE_URL=postgresql://user:password@localhost:5432/pdf_nexus

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional AI Features (Leave blank if not using AI)
GEMINI_API_KEY=
OPENAI_API_KEY=
